<%- include('../layout', { title: 'Manage Trending News' }) %>

<section class="container py-4">
  <h2 class="mb-4"><i class="fas fa-fire me-2"></i>Manage Trending News</h2>
  <div class="table-responsive">
    <table class="table table-hover">
      <thead>
        <tr><th>Title</th><th>Category</th><th>Prediction</th><th>Date</th><th>Actions</th></tr>
      </thead>
      <tbody id="trendingTableBody"></tbody>
    </table>
  </div>
</section>

<script>
  async function loadTrending() {
    try {
      const res = await axios.get('/api/trending');
      const items = res.data.trending;
      const tbody = document.getElementById('trendingTableBody');
      tbody.innerHTML = items.map(item => `
        <tr>
          <td>${item.title}</td>
          <td>${item.category}</td>
          <td><span class="badge bg-danger">${item.prediction}</span></td>
          <td>${new Date(item.createdAt).toLocaleDateString()}</td>
          <td>
            <button class="btn btn-sm btn-danger deleteTrending" data-id="${item._id}">Delete</button>
          </td>
        </tr>
      `).join('');
      document.querySelectorAll('.deleteTrending').forEach(btn => {
        btn.addEventListener('click', async function() {
          if (!confirm('Delete this trending news?')) return;
          try {
            await axios.delete(`/api/admin/trending/${this.dataset.id}`);
            loadTrending();
            showToast('success', 'Deleted');
          } catch (err) {
            showToast('error', 'Delete failed');
          }
        });
      });
    } catch (err) {
      showToast('error', 'Failed to load trending');
    }
  }
  loadTrending();
</script>