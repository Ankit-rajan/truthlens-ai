<%- include('../layout', { title: 'Admin Dashboard' }) %>

<section class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="display-6 fw-bold"><i class="fas fa-user-shield me-2"></i>Admin Dashboard</h1>
  </div>

  <!-- Stats Cards -->
  <div class="row g-4 mb-4" id="adminStats">
    <div class="col-md-3">
      <div class="glass-card p-3 text-center">
        <h3 class="fw-bold" id="totalUsers">0</h3>
        <p class="text-muted">Total Users</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card p-3 text-center">
        <h3 class="fw-bold" id="totalAnalyses">0</h3>
        <p class="text-muted">Total Analyses</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card p-3 text-center">
        <h3 class="fw-bold" id="totalTrending">0</h3>
        <p class="text-muted">Trending News</p>
      </div>
    </div>
    <div class="col-md-3">
      <div class="glass-card p-3 text-center">
        <h3 class="fw-bold" id="totalReports">0</h3>
        <p class="text-muted">Reports Generated</p>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row g-4">
    <div class="col-md-6">
      <div class="glass-card p-4">
        <h5>Predictions Breakdown</h5>
        <canvas id="predictionChart" height="200"></canvas>
      </div>
    </div>
    <div class="col-md-6">
      <div class="glass-card p-4">
        <h5>Monthly Activity</h5>
        <canvas id="monthlyChart" height="200"></canvas>
      </div>
    </div>
  </div>
</section>

<script>
  // Fetch stats and render charts
  (async function() {
    try {
      const statsRes = await axios.get('/api/admin/stats');
      const stats = statsRes.data.stats;
      document.getElementById('totalUsers').textContent = stats.totalUsers;
      document.getElementById('totalAnalyses').textContent = stats.totalAnalyses;
      document.getElementById('totalTrending').textContent = stats.totalTrending || 0;
      document.getElementById('totalReports').textContent = stats.totalReports || 0;

      // Prediction pie
      const predData = stats.predictions || [];
      const labels = predData.map(p => p._id);
      const values = predData.map(p => p.count);
      new Chart(document.getElementById('predictionChart'), {
        type: 'pie',
        data: { labels, datasets: [{ data: values, backgroundColor: ['#dc3545', '#fd7e14', '#ffc107', '#28a745'] }] }
      });

      // Monthly line
      const monthlyRes = await axios.get('/api/admin/analytics');
      const monthly = monthlyRes.data.monthly || [];
      const monthLabels = monthly.map(m => `${m._id.month}/${m._id.year}`);
      const monthCounts = monthly.map(m => m.count);
      new Chart(document.getElementById('monthlyChart'), {
        type: 'line',
        data: { labels: monthLabels, datasets: [{ label: 'Analyses', data: monthCounts, borderColor: '#6c5ce7' }] }
      });
    } catch (err) {
      console.error(err);
    }
  })();
</script>