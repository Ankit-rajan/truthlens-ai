<section class="container py-4">
  <div class="row">
    <div class="col-md-4">
      <div class="glass-card p-4 text-center">
        <img src="<%= user.photo || '/images/default-avatar.png' %>" alt="Profile" class="rounded-circle mb-3" width="100" height="100" />
        <h4><%= user.name %></h4>
        <p class="text-muted"><%= user.email %></p>
        <a href="/profile" class="btn btn-outline-primary btn-sm">Edit Profile</a>
      </div>
    </div>
    <div class="col-md-8">
      <div class="glass-card p-4">
        <h5>Recent Activity</h5>
        <ul class="list-group list-group-flush">
          <% history.forEach(item => { %>
            <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center">
              <span><%= item.title %></span>
              <span class="badge bg-<%= item.prediction === 'True' ? 'success' : (item.prediction === 'Partially True' ? 'warning' : 'danger') %>"><%= item.prediction %></span>
            </li>
          <% }) %>
        </ul>
        <div class="mt-3">
          <canvas id="confidenceChart" width="400" height="200"></canvas>
        </div>
      </div>
    </div>
  </div>
</section>
<script src="/js/dashboard.js"></script>
