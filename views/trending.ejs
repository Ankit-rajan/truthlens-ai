
<section class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
<h1 class="display-6 fw-bold">
    <i class="fas fa-search text-primary me-2"></i>
    TruthLens Live Analysis
</h1>    <% if (currentUser && currentUser.role === 'admin') { %>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTrendingModal">
        <i class="fas fa-plus me-2"></i>Add New
      </button>
    <% } %>
  </div>

  <!-- Search & Filter -->
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <input type="text" class="form-control" id="searchTrending" placeholder="Search by title..." value="<%= filters.search || '' %>" />
    </div>
    <div class="col-md-4">
      <select class="form-select" id="filterCategory">
        <option value="">All Categories</option>
        <option value="Politics" <%= filters.category === 'Politics' ? 'selected' : '' %>>Politics</option>
        <option value="Health" <%= filters.category === 'Health' ? 'selected' : '' %>>Health</option>
        <option value="Sports" <%= filters.category === 'Sports' ? 'selected' : '' %>>Sports</option>
        <option value="Finance" <%= filters.category === 'Finance' ? 'selected' : '' %>>Finance</option>
        <option value="Technology" <%= filters.category === 'Technology' ? 'selected' : '' %>>Technology</option>
        <option value="Entertainment" <%= filters.category === 'Entertainment' ? 'selected' : '' %>>Entertainment</option>
      </select>
    </div>
    <div class="col-md-2">
      <button class="btn btn-outline-primary w-100" id="applyFilters">Filter</button>
    </div>
  </div>

  <!-- Trending Cards -->
  <div class="row g-4" id="trendingContainer">
    <% trending.forEach(item => { %>
      <div class="col-md-4">
        <div class="card h-100 glass-card border-0">
          <img src="<%= item.image || '/images/default-news.jpg' %>" class="card-img-top" alt="<%= item.title %>" style="height: 200px; object-fit: cover;">
          <div class="card-body">
            <span class="badge bg-danger mb-2"><%= item.prediction %></span>
            <span class="badge bg-secondary mb-2"><%= item.category %></span>
            <h5 class="card-title"><%= item.title %></h5>
            <p class="card-text text-muted"><%= item.description ? item.description.substring(0, 100) : '' %></p>
            <div class="d-flex justify-content-between align-items-center">
              <small class="text-muted"><i class="fas fa-clock me-1"></i><%= new Date(item.createdAt).toLocaleDateString() %></small>
              <a href="/trending/<%= item._id %>" class="btn btn-sm btn-outline-primary">View Details</a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Admin Add Trending Modal -->
  <div class="modal fade" id="addTrendingModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content glass-card">
        <div class="modal-header">
          <h5 class="modal-title">Add Trending Fake News</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="addTrendingForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <div class="mb-3">
              <label>Title</label>
              <input type="text" class="form-control" name="title" required />
            </div>
            <div class="mb-3">
              <label>Description</label>
              <textarea class="form-control" name="description" rows="2"></textarea>
            </div>
            <div class="mb-3">
              <label>Category</label>
              <select class="form-select" name="category" required>
                <option value="Politics">Politics</option>
                <option value="Health">Health</option>
                <option value="Sports">Sports</option>
                <option value="Finance">Finance</option>
                <option value="Technology">Technology</option>
                <option value="Entertainment">Entertainment</option>
              </select>
            </div>
            <div class="mb-3">
              <label>Prediction</label>
              <select class="form-select" name="prediction">
                <option value="Fake">Fake</option>
                <option value="Likely Fake">Likely Fake</option>
                <option value="Partially True">Partially True</option>
                <option value="True">True</option>
              </select>
            </div>
            <div class="mb-3">
              <label>Image URL</label>
              <input type="text" class="form-control" name="image" placeholder="https://..." />
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="saveTrendingBtn">Save</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script src="/js/trending.js"></script>
