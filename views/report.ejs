
<section class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="glass-card p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-start mb-4">
          <h2 class="fw-bold"><i class="fas fa-file-alt text-primary me-2"></i>Report</h2>
          <div>
            <a href="/api/news/report/<%= report._id %>" class="btn btn-success"><i class="fas fa-file-pdf me-2"></i>Download PDF</a>
            <button class="btn btn-outline-secondary" onclick="window.print()"><i class="fas fa-print"></i></button>
          </div>
        </div>

        <div class="mb-4">
          <h5>Article</h5>
          <p class="text-muted"><%= report.title %></p>
          <div class="bg-light p-3 rounded"><%= report.content %></div>
        </div>

        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <div class="p-3 bg-<%= report.prediction === 'True' ? 'success' : (report.prediction === 'Partially True' ? 'warning' : 'danger') %> text-white rounded">
              <h6>Verdict</h6>
              <h4><%= report.prediction %></h4>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-3 bg-primary text-white rounded">
              <h6>Confidence</h6>
              <h4><%= report.confidence %>%</h4>
              <div class="progress" style="height:6px;">
                <div class="progress-bar bg-warning" style="width:<%= report.confidence %>%"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-3">
          <h6>Reasons</h6>
          <ul>
            <% report.reasons.forEach(r => { %><li><%= r %></li><% }) %>
          </ul>
        </div>

        <% if (report.evidence && report.evidence.length) { %>
          <div class="mb-3">
            <h6>Evidence</h6>
            <ul><% report.evidence.forEach(e => { %><li><%= e %></li><% }) %></ul>
          </div>
        <% } %>

        <% if (report.claims && report.claims.length) { %>
          <div class="mb-3">
            <h6>Detected Claims</h6>
            <ul><% report.claims.forEach(c => { %><li><%= c %></li><% }) %></ul>
          </div>
        <% } %>

        <div class="row g-3">
          <div class="col-md-6">
            <p><strong>Bias:</strong> <%= report.bias || 'N/A' %></p>
            <p><strong>Emotional Tone:</strong> <%= report.emotionalTone || 'N/A' %></p>
          </div>
          <div class="col-md-6">
            <p><strong>Clickbait Score:</strong> <%= report.clickbaitScore || 'N/A' %></p>
            <p><strong>Fact Consistency:</strong> <%= report.factConsistency || 'N/A' %></p>
          </div>
        </div>

        <div class="mt-4 text-muted small">
          Analyzed on: <%= new Date(report.createdAt).toLocaleString() %>
        </div>
      </div>
    </div>
  </div>
</section>
