# Server
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/truthlens

# JWT / Auth
# JWT_SECRET signs short-lived access tokens; JWT_REFRESH_SECRET signs the
# longer-lived refresh token. Use two DIFFERENT long random strings in
# production (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string
JWT_REFRESH_EXPIRE=7d

# Admin seed — a real MongoDB admin user is created automatically on server
# startup (or via `node createAdmin.js`) using these credentials. Change the
# password immediately after first login.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@truthlens.com
ADMIN_PASSWORD=change_this_secure_password

# Email (used for verification + password reset links)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# AI Provider — 'groq' or 'gemini'
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_key

# Trending news ingestion
NEWS_API_KEY=your_newsapi_org_key

# Image uploads (optional — falls back to local /uploads storage if unset)
CLOUDINARY_CLOUD_NAME=your_cloud
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
